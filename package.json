{
  "name": "amo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AMO — Aplikasi Management ONU (monorepo: API Fastify + Web React/Vite + shared)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @amo/api",
    "dev:web": "npm run dev -w @amo/web",
    "build": "npm run build -w @amo/api && npm run build -w @amo/web",
    "start": "npm run build && concurrently -k -n api,web -c blue,green \"npm:start:api\" \"npm:start:web\"",
    "start:api": "npm run start -w @amo/api",
    "start:web": "npm run preview -w @amo/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @amo/api",
    "db:migrate": "npm run db:migrate -w @amo/api",
    "db:seed": "npm run db:seed -w @amo/api",
    "openapi:export": "npm run openapi:export -w @amo/api",
    "docker:dev-db": "docker compose --env-file .env -f deploy/compose.yml -f deploy/compose.dev.yml up -d mysql",
    "docker:up": "docker compose --env-file .env -f deploy/compose.yml up -d --build",
    "docker:down": "docker compose --env-file .env -f deploy/compose.yml down"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2"
  }
}
