# ════════════════════════════════════════════════════════════════════════════
#  AMO — environment mode PRODUCTION lokal (`npm run start`)
#
#  Urutan pemuatan otomatis oleh `npm run start` (nilai berikutnya MENIMPA):
#    1. .env             (secret & kredensial Anda — sama dengan dev)
#    2. .env.production  (file ini — pengaturan mode produksi, menimpa .env)
#    3. environment shell (menimpa semua)
#
#  Prasyarat: `npm run build` sudah dijalankan (API → apps/api/dist,
#  Web → apps/web/dist) dan DATABASE_URL menunjuk ke MySQL yang sudah
#  di-migrate (`npm run db:migrate`).
#
#  Catatan deploy Docker (compose): file ini TIDAK dipakai di sana — compose
#  menyetel sendiri NODE_ENV/DATABASE_URL/TRUST_PROXY lewat `environment:`.
# ════════════════════════════════════════════════════════════════════════════

NODE_ENV=production
LOG_LEVEL=info

# Frontend disajikan oleh Fastify (apps/web/dist hasil `npm run build`) —
# satu origin dengan API, pengganti Nginx untuk mode `npm run start`.
SERVE_WEB=true
# PORT tetap 3000 dari .env (API + web sekaligus di satu port).

# Origin publik = tempat browser mengakses aplikasi. Dipakai untuk CORS,
# proteksi CSRF (header Origin), dan flag Secure cookie.
#   - Akses via http://localhost:3000 → biarkan seperti di bawah.
#   - Deploy dengan domain/TLS → ganti ke https://domainanda.com
APP_BASE_URL=http://localhost:3000

# true HANYA bila API berada di belakang reverse proxy tepercaya (Nginx dkk).
TRUST_PROXY=false

# Swagger UI (/docs) — disarankan dimatikan di produksi publik.
API_DOCS_ENABLED=false
