# ════════════════════════════════════════════════════════════════════════════
#  AMO Web + Reverse proxy (Nginx). Build dari ROOT repo:
#     docker build -f deploy/Dockerfile.web -t amo-web .
#  Satu-satunya container yang menerima traffic publik (PRD §15.1).
# ════════════════════════════════════════════════════════════════════════════
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/web/package.json apps/web/
RUN npm ci -w @amo/web -w @amo/shared --include-workspace-root=false
COPY packages/shared packages/shared
COPY apps/web apps/web
RUN npm run build -w @amo/web

FROM nginx:1.27-alpine
COPY deploy/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY deploy/nginx/proxy_params.inc /etc/nginx/conf.d/proxy_params.inc
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
EXPOSE 80
