# ════════════════════════════════════════════════════════════════════════════
#  AMO — contoh environment (salin menjadi `.env`, JANGAN commit `.env`)
#  Nama variabel mengikuti kontrak PRD §8.2. Variabel bertanda [+] adalah
#  tambahan starter kit (belum ada di PRD) — dijelaskan di komentarnya.
# ════════════════════════════════════════════════════════════════════════════

# ── API ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info                      # [+] fatal|error|warn|info|debug|trace|silent
# Origin URL publik aplikasi WEB. Dipakai untuk: CORS, pemeriksaan header Origin
# (proteksi CSRF), dan flag `Secure` pada cookie (otomatis aktif bila https://).
#   dev    : http://localhost:5173   (Vite dev server)
#   produksi: https://domainutama.com
APP_BASE_URL=http://localhost:5173
# [+] true bila API berada di belakang reverse proxy tepercaya (Nginx) agar
#     request.ip membaca X-Forwarded-For. JANGAN true bila API terekspos langsung.
TRUST_PROXY=false
# [+] Swagger UI di /docs. Disarankan false di produksi publik.
API_DOCS_ENABLED=true

# [+] Mode produksi tanpa Docker (`npm run start`): true = Fastify menyajikan
#     frontend hasil `npm run build` (apps/web/dist) di origin yang sama dengan API.
#     Nilai produksi (true) disetel di .env.production — biarkan false di sini.
SERVE_WEB=false
# [+] Timpa lokasi dist frontend bila tidak di lokasi default ../web/dist.
WEB_DIST_DIR=

# ── Sesi (PRD §10.4) ────────────────────────────────────────────────────────
# Minimal 32 karakter acak. Contoh membuat:  openssl rand -hex 48
# Dipakai untuk menurunkan token CSRF (HMAC). Mengganti nilai ini akan membuat
# semua token CSRF lama tidak valid (user cukup memuat ulang halaman).
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
SESSION_TTL_HOURS=12                # [+] umur maksimum sesi (absolut)
SESSION_IDLE_TIMEOUT_MINUTES=60     # [+] sesi dicabut bila tidak ada aktivitas selama ini

# ── Database ────────────────────────────────────────────────────────────────
# Lokal (npm run dev)  : host 127.0.0.1 (MySQL dari `npm run docker:dev-db`)
# Docker Compose penuh : ganti host menjadi `mysql`
DATABASE_URL=mysql://amo_user:amo_password@127.0.0.1:3306/amo
DB_POOL_SIZE=10                     # [+]
# Dipakai oleh deploy/compose.yml untuk membuat container MySQL:
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=amo
MYSQL_USER=amo_user
MYSQL_PASSWORD=amo_password

# ── Akun admin awal (dipakai `npm run db:seed`) ─────────────────────────────
# [+] Ganti SEGERA. Pada NODE_ENV=production password < 12 karakter akan ditolak.
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe!12345

# ── GenieACS (PRD §8) — secret ini TIDAK PERNAH dikirim ke browser ───────────
GENIEACS_NBI_URL=http://genieacs-nbi:7557
GENIEACS_USERNAME=
GENIEACS_PASSWORD=
GENIEACS_TIMEOUT_MS=10000
GENIEACS_SYNC_INTERVAL_SECONDS=60
# [+] Perangkat dianggap OFFLINE bila last inform lebih lama dari ini (detik).
#     Idealnya ≥ 2× periodic inform interval pada CPE (umumnya 300 dtk).
ONLINE_THRESHOLD_SECONDS=600

# ── Kebijakan remote proxy (PRD §10) ────────────────────────────────────────
REMOTE_ALLOWED_PORTS=80,443
REMOTE_ALLOWED_SCHEMES=http,https
REMOTE_SESSION_REQUIRED=true
REMOTE_AUDIT_ENABLED=true
# [+] Allowlist CIDR jaringan manajemen ONU, pisahkan dengan koma. Contoh: 172.2.0.0/16,10.20.0.0/16
#     KOSONG = tidak ada target yang diizinkan (aman secara default).
#     Loopback, link-local & metadata cloud selalu ditolak apa pun isinya.
REMOTE_ALLOWED_CIDRS=
